# ==============================================================================
# OTPCord Backend Environment Variables
# ==============================================================================

# Server Environment (production / development)
NODE_ENV=production

# Server Port and Host
PORT=4000
HOST=0.0.0.0

# Public Production URLs
API_URL=https://api.otpcord.hu
WS_URL=wss://api.otpcord.hu
CLIENT_URL=https://otpcord.hu

# Production Database (Host: mysql.rackhost.hu)
DB_HOST=mysql.rackhost.hu
DB_PORT=3306
DB_NAME=<SECRET_DB_NAME>
DB_USER=<SECRET_DB_USER>
DB_PASSWORD=<SECRET_DB_PASSWORD>

# JWT Authentication Secrets
JWT_SECRET=<SECRET_JWT_SIGNING_KEY_MIN_32_CHARS>
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=<SECRET_JWT_REFRESH_KEY>
JWT_REFRESH_EXPIRES_IN=30d

# File Upload Configuration
MAX_FILE_SIZE_MB=50

# WebRTC STUN / TURN Configuration
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Optional TURN server for symmetric NAT traversal
# TURN_SERVER=turn:turn.otpcord.hu:3478
# TURN_USERNAME=otpcord
# TURN_CREDENTIAL=<TURN_SECRET>
